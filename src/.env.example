# Neon pooled connection string for runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Neon direct connection string for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_SESSION_SECRET="replace-with-another-32-random-characters"
CONFIG_ENCRYPTION_KEY="replace-with-a-long-random-secret"
OPENROUTER_API_KEY=""
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Skibidi IELTS"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-at-least-12-characters"
