generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String               @id @default(cuid())
  username         String               @unique
  passwordHash     String
  planId           String
  planStartedAt    DateTime             @default(now())
  planExpireDate   DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  plan             Plan                 @relation(fields: [planId], references: [id])
  submissions      WritingSubmission[]
  aiUsage          AIUsage[]
  promoRedemptions PromoRedemption[]
  paymentRequests  BankPaymentRequest[]

  @@index([planId])
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Plan {
  id               String               @id @default(cuid())
  name             String               @unique
  price            Decimal              @db.Decimal(10, 2)
  durationDays     Int                  @default(30)
  aiRequestLimit   Int                  @default(1)
  aiModel          String
  features         Json
  isVisible        Boolean              @default(true)
  isFree           Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  users            User[]
  promoCodes       PromoCode[]
  paymentRequests  BankPaymentRequest[]

  @@index([isVisible])
}

model VocabularyGroup {
  id        String            @id @default(cuid())
  name      String            @unique
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  topics    VocabularyTopic[]
}

model VocabularyTopic {
  id              String            @id @default(cuid())
  groupId         String
  name            String
  sortOrder       Int               @default(0)
  isSupplementary Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  group     VocabularyGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  words     VocabularyWord[]

  @@unique([groupId, name])
  @@index([groupId])
}

model VocabularyWord {
  id          String          @id @default(cuid())
  topicId     String
  word        String
  meaning     String?
  example     String?
  translation String?
  synonyms    String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  topic       VocabularyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, word])
  @@index([topicId])
}

model WritingSubmission {
  id                   String   @id @default(cuid())
  userId               String
  taskType             String
  taskPrompt           String?
  promptAttachmentName String?
  input                String
  imageUrl             String?
  attachmentName       String?
  bandScore            Decimal  @db.Decimal(3, 1)
  feedback             Json
  featuresSnapshot     Json
  modelUsed            String
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PromoCode {
  id          String            @id @default(cuid())
  code        String            @unique
  planId      String
  duration    Int               @default(30)
  isActive    Boolean           @default(true)
  maxUses     Int?
  usedCount   Int               @default(0)
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  plan        Plan              @relation(fields: [planId], references: [id])
  redemptions PromoRedemption[]

  @@index([planId])
}

model PromoRedemption {
  id        String    @id @default(cuid())
  promoId   String
  userId    String
  createdAt DateTime  @default(now())
  promo     PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoId, userId])
  @@index([userId])
}

model AIUsage {
  id           String   @id @default(cuid())
  userId       String
  requestCount Int      @default(1)
  date         DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model AISetting {
  id              String   @id @default("default")
  defaultModel    String
  encryptedApiKey String?
  updatedAt       DateTime @updatedAt
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model BankPaymentRequest {
  id           String   @id @default(cuid())
  userId       String
  planId       String
  amount       Decimal  @db.Decimal(10, 2)
  transferCode String   @unique
  status       String   @default("PENDING")
  adminNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviewedAt   DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([planId])
  @@index([status, createdAt])
}
